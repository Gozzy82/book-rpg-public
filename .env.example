# Server
BOOKRPG_PORT=8787
BOOKRPG_HOST=127.0.0.1
# Optional. Blank uses the primary Git worktree's data folder so the CLI and
# website see the same imported books and saved games from every worktree.
BOOKRPG_DATA_DIR=
BOOKRPG_AUTH_MODE=local
BOOKRPG_STORAGE_MODE=local
# Production uses the user-assigned identity client ID generated by Bicep.
AZURE_CLIENT_ID=

# Azure production storage. These are set by Azure infrastructure when
# BOOKRPG_STORAGE_MODE=azure.
AZURE_STORAGE_ACCOUNT_NAME=
BOOKRPG_BOOKS_CONTAINER=books
COSMOS_ENDPOINT=
COSMOS_DATABASE=bookrpg
COSMOS_GAMES_CONTAINER=games

# Optional Application Insights OpenTelemetry instrumentation.
APPLICATIONINSIGHTS_CONNECTION_STRING=
BOOKRPG_TELEMETRY_SAMPLING_RATIO=0.25

# AI
# Set to 1 first: full end-to-end test with no API calls/cost.
BOOKRPG_FAKE_AI=1
BOOKRPG_AI_PROVIDER=openai
# Optional provider-independent override; blank uses the provider default below.
BOOKRPG_AI_MODEL=
# Optional stronger model used only for one-time book analysis and indexing.
# Blank falls back to BOOKRPG_AI_MODEL or the provider default.
BOOKRPG_INDEX_MODEL=gpt-5.6-luna
# Baseline effort. Consequential betrayal, violence, magic-rule, confession,
# surrender, and similarly irreversible decisions automatically use high.
BOOKRPG_AI_REASONING_EFFORT=minimal
# Full local JSONL request/response/error log for every application provider call.
# App-level retries share a callId and increase attempt. Set to off to disable.
BOOKRPG_AI_LOG_FILE=./data/ai-provider-calls.jsonl

# OpenAI
OPENAI_API_KEY=
# Windows alternative: a DPAPI-protected PSCredential. Defaults to
# %USERPROFILE%\.bookrpg-openai-key.clixml when BOOKRPG_FAKE_AI=0.
BOOKRPG_OPENAI_CREDENTIAL_FILE=
# Provider default and legacy model/reasoning settings remain supported.
OPENAI_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=minimal

# xAI / Grok
XAI_API_KEY=
# Windows alternative; defaults to %USERPROFILE%\.bookrpg-xai-key.clixml.
BOOKRPG_XAI_CREDENTIAL_FILE=
# Grok 4.6 maps the app-level minimal reasoning setting to its fastest level, low.
XAI_MODEL=grok-4.6


# Complete flow blocks in terminal/web logs and <BOOKRPG_DATA_DIR>/logs/games/<gameId>.log.
# Appends across turns and restarts; off disables both console flow blocks and files.
BOOKRPG_FLOW_LOG=true

