{
  "name": "bookrpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server/bootstrap.ts",
    "dev:client": "tsx src/client/cli.ts",
    "import": "tsx src/books/import-cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server/bootstrap.js",
    "client": "node dist/src/client/cli.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@azure/core-auth": "^1.11.0",
    "@azure/cosmos": "^4.10.0",
    "@azure/identity": "^4.13.2",
    "@azure/monitor-opentelemetry": "^1.19.0",
    "@azure/storage-blob": "^12.33.0",
    "adm-zip": "^0.6.0",
    "fast-xml-parser": "^5.2.5",
    "openai": "^7.7.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
